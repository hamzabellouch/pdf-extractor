{
  "manifest_version": 3,
  "name": "PDF Extractor",
  "version": "1.1.0",
  "description": "Export document previews from Google Drive and direct PDF links as PDF, ZIP, or images.",
  "action": {
    "default_popup": "index.html"
  },
  "content_scripts": [
    {
      "js": [
        "assets/pdf.min.js",
        "assets/content.js"
      ],
      "matches": [
        "https://drive.google.com/*",
        "https://docs.google.com/*",
        "*://*/*.pdf",
        "*://*/*.pdf?*",
        "*://*/*.PDF",
        "*://*/*.PDF?*",
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icon_16x16.png",
    "32": "icon_32x32.png",
    "48": "icon_48x48.png",
    "128": "icon_128x128.png"
  },
  "permissions": [
    "activeTab"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "pdf-extractor@tknoglobal",
      "strict_min_version": "109.0"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/pdf.worker.min.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}